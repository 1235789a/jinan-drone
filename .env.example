# Copy this file to .env and fill in your API keys
# ====================================================

# === Option A: Individual providers (original endpoints) ===
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

ZHIPU_API_KEY=xxx.xxx
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.5          # upgrade to glm-5.1 when available in your tier

DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus     # or qwen3-plus / qwen3.6-plus

MOONSHOT_API_KEY=sk-xxx
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-32k

# === Option B: One key rules all (SiliconFlow aggregator) ===
# If you use SiliconFlow, you only need this one key. The pipeline will route
# all 4 models through the same endpoint.
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# === Pipeline config ===
MAX_CONCURRENT=5              # concurrent API calls per provider
MAX_RETRIES=3
REQUEST_TIMEOUT=60
