# Copy this to .env and fill in your keys. NEVER share keys with anyone.
# =======================================================================

# === SiliconFlow: covers DeepSeek + Qwen (2 data sources via 1 key) ===
# Sign up: https://cloud.siliconflow.cn (16 CNY free on signup)
# FREE models confirmed May 2026: DeepSeek-V3, Qwen2.5-7B-Instruct
# PAID (403 on free): GLM-4.5, Qwen3-235B, DeepSeek-V4-Pro/Flash
SILICONFLOW_API_KEY=sk-xxx

# === Claude via proxy (META-JUDGE only) ===
# Use any OpenAI-compatible Claude proxy (api123.top, openai-sb, etc.)
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_BASE_URL=https://api123.top/v1
ANTHROPIC_MODEL=claude-sonnet-4-6

# === Pipeline tuning ===
MAX_CONCURRENT=2
REQUEST_TIMEOUT=180
