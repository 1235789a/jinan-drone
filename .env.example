# Copy this file to .env and fill in your API keys.
# .env is gitignored. NEVER share your keys with anyone.
# =====================================================

# === SiliconFlow: covers DeepSeek + GLM + Qwen (3 data sources via 1 key) ===
# Sign up at https://cloud.siliconflow.cn  (16 CNY free credit on signup)
SILICONFLOW_API_KEY=sk-xxx
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1   # default, no need to change

# (Optional) Override per-model IDs if you want to swap to Flash tier to save budget:
# DEEPSEEK_SF_MODEL=deepseek-ai/DeepSeek-V4-Flash
# GLM_SF_MODEL=zai-org/GLM-4.5
# QWEN_SF_MODEL=Qwen/Qwen3-235B-A22B


# === Google Gemini: 4th data source (FREE tier) ===
# Get key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSy-xxx
# GEMINI_MODEL=gemini-2.5-flash   # default; gemini-2.5-pro if you have paid access


# === Claude via OpenAI-compatible proxy (for META-JUDGE role) ===
# Use any proxy that exposes Claude behind an OpenAI-compatible endpoint.
# Example: api123.top, openai-sb, api2d, ohmygpt, etc.
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_BASE_URL=https://api.xxx.top/v1
ANTHROPIC_MODEL=claude-sonnet-4-6
# Upgrade path (expensive!):
# ANTHROPIC_MODEL=claude-opus-4-7         # ~5x cost
# ANTHROPIC_MODEL=claude-opus-4-7-thinking # ~12x cost, use only for calibration anchors


# === Pipeline tuning ===
MAX_CONCURRENT=5
REQUEST_TIMEOUT=60
